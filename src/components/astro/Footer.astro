---
/**
 * src/components/astro/Footer.astro
 * ===========================================================================
 * Site-wide footer — Brief Rev 2, Section 17.
 *
 * Five column groups:
 *   1. Imports
 *   2. Exports
 *   3. Services
 *   4. Tools & support
 *   5. Global network
 *
 * Plus company info block, legal strip and LocalBusiness schema.
 *
 * Content pulled from routes.ts config so adding routes only touches config.
 * ===========================================================================
 */

import { site } from "@/config/site";
import {
  coreRoutes,
  originRoutes,
  destinationRoutes,
  toolRoutes,
  shippingCentreRoutes,
  shippingCentreLanding,
  locationRoutes,
  locationsLanding,
  importLanding,
  exportLanding,
} from "@/config/routes";

const importLinks = [
  ...Object.values(originRoutes).map((r) => ({
    label: r.label + " → Kenya",
    path: r.path,
  })),
];

const exportLinks = [
  ...Object.values(destinationRoutes).map((d) => ({
    label: "Kenya → " + d.label,
    path: d.path,
  })),
  { label: "Other supported destinations", path: exportLanding.path },
];

const serviceLinks = [
  { label: "Air Freight",         path: coreRoutes.airFreight.path },
  { label: "Sea Freight",         path: coreRoutes.seaFreight.path },
  { label: "Customs Clearance",   path: coreRoutes.customsClearance.path },
  { label: "Cargo Consolidation", path: coreRoutes.cargoConsolidation.path },
  { label: "Door-to-Door",        path: coreRoutes.doorToDoor.path },
  { label: "Shop & Ship",         path: coreRoutes.shopAndShip.path },
  { label: "Business Logistics",  path: coreRoutes.businessLogistics.path },
];

const toolLinks = [
  { label: "Shipping Calculator", path: toolRoutes.shippingCalculator.path },
  { label: "Volumetric Weight",   path: toolRoutes.volumetricWeightCalculator.path },
  { label: "CBM Calculator",      path: toolRoutes.cbmCalculator.path },
  { label: "Track Shipment",      path: toolRoutes.trackShipment.path },
  { label: "Shipping Centre",     path: shippingCentreLanding.path },
  { label: "Contact",             path: coreRoutes.contact.path },
];

const networkLinks = [
  { label: "Kenya",          path: locationRoutes.nairobi.path },
  { label: "United Kingdom", path: locationRoutes.uk.path },
  { label: "China",          path: locationRoutes.guangzhou.path },
  { label: "UAE",            path: locationRoutes.dubai.path },
  { label: "United States",  path: locationRoutes.usa.path },
  { label: "South Africa",   path: locationRoutes["south-africa"].path },
];

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name + " — Nairobi",
  url: site.productionUrl,
  telephone: site.contact.phoneE164,
  email: site.contact.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Warehouse No. 2, Shell Petrol Station, Lunga Lunga Road",
    addressLocality: "Nairobi",
    addressRegion: "Nairobi County",
    addressCountry: "KE",
  },
  areaServed: [
    { "@type": "Country", name: "Kenya" },
  ],
};
---

<footer class="bg-secondary text-secondary-foreground mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="py-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8">

      <!-- Company block -->
      <div class="lg:col-span-1 space-y-5">
        <a href="/" class="inline-block" aria-label={site.name + " home"}>
          <img
            src="/images/logo-transparent.png"
            alt={site.name}
            class="h-10 w-auto"
            width="160"
            height="40"
            loading="lazy"
          />
        </a>

        <p class="text-sm text-secondary-foreground/80 leading-relaxed">
          Global import and export logistics connecting Kenya with international markets.
        </p>

        <div class="flex items-center gap-2 text-sm">
          <svg class="h-4 w-4 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke-linecap="round" stroke-linejoin="round"/>
            <polyline points="22,6 12,13 2,6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <a href={"mailto:" + site.contact.email} class="hover:text-accent transition-colors">
            {site.contact.email}
          </a>
        </div>

        <div class="flex gap-4 pt-1">
          <a href="https://www.facebook.com/share/1PDyn69iXs/" target="_blank" rel="noopener noreferrer" class="text-secondary-foreground/60 hover:text-accent transition-colors" aria-label="Facebook">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.24.19 2.24.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.57v1.87h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/kisimacargoltd" target="_blank" rel="noopener noreferrer" class="text-secondary-foreground/60 hover:text-accent transition-colors" aria-label="Instagram">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="12" r="4" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
            </svg>
          </a>
          <a href="https://www.tiktok.com/@kisimacargoltdmain" target="_blank" rel="noopener noreferrer" class="text-secondary-foreground/60 hover:text-accent transition-colors" aria-label="TikTok">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.88a8.16 8.16 0 0 0 4.77 1.52V6.95a4.85 4.85 0 0 1-1.84-.26z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Imports -->
      <div>
        <h3 class="font-heading font-semibold text-accent mb-4 text-sm uppercase tracking-wide">Imports</h3>
        <ul class="space-y-2">
          {importLinks.map((link) => (
            <li>
              <a href={link.path} class="text-sm text-secondary-foreground/80 hover:text-accent transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Exports -->
      <div>
        <h3 class="font-heading font-semibold text-accent mb-4 text-sm uppercase tracking-wide">Exports</h3>
        <ul class="space-y-2">
          {exportLinks.map((link) => (
            <li>
              <a href={link.path} class="text-sm text-secondary-foreground/80 hover:text-accent transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-heading font-semibold text-accent mb-4 text-sm uppercase tracking-wide">Services</h3>
        <ul class="space-y-2">
          {serviceLinks.map((link) => (
            <li>
              <a href={link.path} class="text-sm text-secondary-foreground/80 hover:text-accent transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Tools & support -->
      <div>
        <h3 class="font-heading font-semibold text-accent mb-4 text-sm uppercase tracking-wide">Tools & support</h3>
        <ul class="space-y-2">
          {toolLinks.map((link) => (
            <li>
              <a href={link.path} class="text-sm text-secondary-foreground/80 hover:text-accent transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Global network -->
      <div>
        <h3 class="font-heading font-semibold text-accent mb-4 text-sm uppercase tracking-wide">Global network</h3>
        <ul class="space-y-2">
          {networkLinks.map((link) => (
            <li>
              <a href={link.path} class="text-sm text-secondary-foreground/80 hover:text-accent transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- CTA strip -->
    <div class="py-8 border-t border-secondary-foreground/20 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-secondary-foreground/80 text-center sm:text-left">
        Ready to ship? Get an instant estimate or talk to us directly.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-4 py-2 text-sm font-semibold transition-colors">
          Get shipping estimate
        </a>
        <a href={coreRoutes.requestQuote.path} class="inline-flex items-center justify-center rounded-md border border-accent text-accent hover:bg-accent hover:text-accent-foreground px-4 py-2 text-sm font-semibold transition-colors">
          Request a quote
        </a>
      </div>
    </div>

    <!-- Legal strip -->
    <div class="py-6 border-t border-secondary-foreground/20 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-secondary-foreground/60 text-center md:text-left">
        © {new Date().getFullYear()} {site.name} Ltd. All rights reserved.
      </p>
      <ul class="flex items-center gap-4 text-xs">
        <li><a href="/privacy-policy" class="text-secondary-foreground/60 hover:text-accent transition-colors">Privacy Policy</a></li>
        <li class="text-secondary-foreground/40">|</li>
        <li><a href="/terms" class="text-secondary-foreground/60 hover:text-accent transition-colors">Terms of Service</a></li>
      </ul>
    </div>

  </div>

  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
</footer>
