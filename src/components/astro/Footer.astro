---
/**
 * src/components/astro/Footer.astro
 * ===========================================================================
 * Site-wide footer. Static HTML only, no JavaScript.
 *
 * Content sources:
 *   - Office addresses and phones: preserved from the original Footer.tsx.
 *     These are real verified data and must not be lost.
 *   - Nav structure: mirrors Header.astro (Brief Section 5).
 *   - LocalBusiness schema: Brief Section 11.
 *
 * Known gap:
 *   /privacy-policy and /terms do not exist yet — they 404 in production.
 *   These pages must be built in Phase 5 before launch (Brief Section 13).
 * ===========================================================================
 */

import { site, whatsappLink, whatsappMessages, absoluteUrl } from "@/config/site";
import { coreRoutes, originRoutes, businessRoutes, toolRoutes, helpLanding } from "@/config/routes";

// ---------------------------------------------------------------------------
// Column model — matches Header nav grouping.
// ---------------------------------------------------------------------------
const columns = [
  {
    heading: "Ship",
    links: [
      { label: "Air Freight",        href: coreRoutes.airFreight.path },
      { label: "Sea Freight",        href: coreRoutes.seaFreight.path },
      { label: "Door-to-Door",       href: coreRoutes.doorToDoor.path },
      { label: "Customs Clearance",  href: coreRoutes.customsClearance.path },
      { label: "Shop & Ship",        href: coreRoutes.shopAndShip.path },
      { label: "Consolidation",      href: coreRoutes.cargoConsolidation.path },
    ],
  },
  {
    heading: "Routes",
    links: Object.values(originRoutes).map((r) => ({
      label: `${r.label} to Kenya`,
      href: r.path,
    })),
  },
  {
    heading: "Business",
    links: Object.values(businessRoutes).map((b) => ({
      label: b.label,
      href: b.path,
    })),
  },
  {
    heading: "Tools & Help",
    links: [
      { label: "Shipping Calculator",   href: toolRoutes.shippingCalculator.path },
      { label: "Volumetric Weight",     href: toolRoutes.volumetricWeightCalculator.path },
      { label: "CBM Calculator",        href: toolRoutes.cbmCalculator.path },
      { label: "Track Shipment",        href: toolRoutes.trackShipment.path },
      { label: "Help Centre",           href: helpLanding.path },
      { label: "Request a Quote",       href: coreRoutes.requestQuote.path },
    ],
  },
];

// ---------------------------------------------------------------------------
// Verified office data (preserved from the current site).
// ---------------------------------------------------------------------------
const offices = [
  {
    country: "Kenya",
    label: "Head Office",
    lines: [
      "Warehouse No. 2, Shell Petrol Station,",
      "Lunga Lunga Road, Industrial Area,",
      "Nairobi, Kenya",
    ],
    phone: "+254795554137",
    phoneDisplay: "+254 795 554 137",
    isHead: true,
  },
  {
    country: "United Kingdom",
    lines: ["Unit 7 Adler Industrial Estate,", "Betam Road, Hayes"],
    phone: "+442030898178",
    phoneDisplay: "+44 20 3089 8178",
    isHead: false,
  },
  {
    country: "UAE",
    label: "Dubai",
    lines: ["Al Zaroni Building M:05,", "Near Gold Souk Gate 1,", "Al Ras, Deira"],
    phone: "+971544218463",
    phoneDisplay: "+971 54 421 8463",
    isHead: false,
  },
  {
    country: "South Africa",
    label: "Johannesburg",
    lines: ["Freight City, Unit 4,", "597 Innes Road, Jet Park,", "Johannesburg"],
    phone: null,
    phoneDisplay: null,
    isHead: false,
  },
  {
    country: "China",
    label: "Guangdong",
    lines: ["Warehouse No. 07, Building C1,", "Dunhao Logistics Center,", "Foshan City, Guangdong"],
    phone: "+8619065400105",
    phoneDisplay: "+86 190 6540 0105",
    isHead: false,
  },
];

// ---------------------------------------------------------------------------
// LocalBusiness schema for the Kenya head office (Brief Section 11).
// Emitted as JSON-LD. Only includes fields we have real values for.
// ---------------------------------------------------------------------------
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: `${site.name} — Nairobi`,
  url: site.productionUrl,
  telephone: "+254795554137",
  email: site.contact.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Warehouse No. 2, Shell Petrol Station, Lunga Lunga Road",
    addressLocality: "Nairobi",
    addressRegion: "Nairobi County",
    addressCountry: "KE",
    // Postal code intentionally omitted — not verified.
  },
  areaServed: [
    { "@type": "Country", name: "Kenya" },
  ],
  // TODO: add geo coordinates once verified
  // TODO: add openingHoursSpecification once verified by Management
  // TODO: add image once real photography exists
};

const waHref = whatsappLink(whatsappMessages.calculatorResult);
---

<footer class="bg-secondary text-secondary-foreground mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- ============ Main footer grid ============ -->
    <div class="py-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8">

      <!-- Company blurb + contact -->
      <div class="lg:col-span-2 space-y-5">
        <a href="/" class="inline-block" aria-label={`${site.name} home`}>
          <img
            src="/images/kisima-logo.png"
            alt={`${site.name} logo`}
            class="h-8 w-auto"
            width="120"
            height="32"
            loading="lazy"
          />
        </a>

        <p class="text-sm text-secondary-foreground/80 leading-relaxed max-w-xs">
          {site.shortDescription}
        </p>

        <div class="flex items-center gap-2 text-sm">
          <svg class="h-4 w-4 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke-linecap="round" stroke-linejoin="round"/>
            <polyline points="22,6 12,13 2,6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <a href={`mailto:${site.contact.email}`} class="hover:text-accent transition-colors">
            {site.contact.email}
          </a>
        </div>

        <!-- Social -->
        <div class="flex gap-4 pt-1">
          <a
            href="https://www.facebook.com/share/1PDyn69iXs/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-secondary-foreground/60 hover:text-accent transition-colors"
            aria-label="Kisima Cargo on Facebook"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.24.19 2.24.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.57v1.87h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94z"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/kisimacargoltd"
            target="_blank"
            rel="noopener noreferrer"
            class="text-secondary-foreground/60 hover:text-accent transition-colors"
            aria-label="Kisima Cargo on Instagram"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="12" r="4" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
            </svg>
          </a>
          <a
            href="https://www.tiktok.com/@kisimacargoltdmain"
            target="_blank"
            rel="noopener noreferrer"
            class="text-secondary-foreground/60 hover:text-accent transition-colors"
            aria-label="Kisima Cargo on TikTok"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.88a8.16 8.16 0 0 0 4.77 1.52V6.95a4.85 4.85 0 0 1-1.84-.26z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      {columns.map((col) => (
        <div>
          <h3 class="font-heading font-semibold text-accent mb-4 text-sm uppercase tracking-wide">
            {col.heading}
          </h3>
          <ul class="space-y-2">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-secondary-foreground/80 hover:text-accent transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

    </div>

    <!-- ============ Offices row ============ -->
    <div class="py-10 border-t border-secondary-foreground/20">
      <h3 class="font-heading font-semibold text-accent mb-6 text-sm uppercase tracking-wide">
        Our Offices
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">

        {offices.map((office) => (
          <div class="space-y-2">
            <div>
              <h4 class="text-sm font-semibold text-secondary-foreground">
                {office.country}
                {office.label && (
                  <span class="ml-1.5 text-accent font-normal">({office.label})</span>
                )}
              </h4>
            </div>
            <address class="not-italic text-xs text-secondary-foreground/70 leading-relaxed">
              {office.lines.map((line, i) => (
                <>
                  {line}
                  {i < office.lines.length - 1 && <br />}
                </>
              ))}
            </address>
            {office.phone && (
              <a
                href={`tel:${office.phone}`}
                class="block text-xs text-accent hover:underline"
              >
                {office.phoneDisplay}
              </a>
            )}
          </div>
        ))}

      </div>
    </div>

    <!-- ============ CTA strip ============ -->
    <div class="py-8 border-t border-secondary-foreground/20 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-secondary-foreground/80 text-center sm:text-left">
        Ready to ship? Get an instant estimate or talk to us directly.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a
          href={toolRoutes.shippingCalculator.path}
          class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-4 py-2 text-sm font-semibold transition-colors"
        >
          Get shipping estimate
        </a>
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-md border border-accent text-accent hover:bg-accent hover:text-accent-foreground px-4 py-2 text-sm font-semibold transition-colors"
        >
          WhatsApp us
        </a>
      </div>
    </div>

    <!-- ============ Legal strip ============ -->
    <div class="py-6 border-t border-secondary-foreground/20 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-secondary-foreground/60 text-center md:text-left">
        © {new Date().getFullYear()} {site.name} Ltd. All rights reserved.
      </p>
      <ul class="flex items-center gap-4 text-xs">
        <li>
          <a href="/privacy-policy" class="text-secondary-foreground/60 hover:text-accent transition-colors">
            Privacy Policy
          </a>
        </li>
        <li class="text-secondary-foreground/40">|</li>
        <li>
          <a href="/terms" class="text-secondary-foreground/60 hover:text-accent transition-colors">
            Terms of Service
          </a>
        </li>
      </ul>
    </div>

  </div>

  <!-- LocalBusiness schema for Kenya head office -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify(localBusinessSchema)}
  />
</footer>
