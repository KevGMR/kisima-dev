---
import { site } from "@/config/site";
import {
  coreRoutes,
  originRoutes,
  destinationRoutes,
  toolRoutes,
  shippingCentreLanding,
  locationsLanding,
  importLanding,
  exportLanding,
} from "@/config/routes";

const importItems = [
  { label: "Import to Kenya", path: importLanding.path },
  { label: "China to Kenya", path: originRoutes.china.path },
  { label: "UK to Kenya", path: originRoutes.uk.path },
  { label: "USA to Kenya", path: originRoutes.usa.path },
  { label: "UAE to Kenya", path: originRoutes.uae.path },
  { label: "South Africa to Kenya", path: originRoutes["south-africa"].path },
];

const exportItems = [
  { label: "Export from Kenya", path: exportLanding.path },
  { label: "Kenya to UK", path: destinationRoutes.uk.path },
  { label: "Kenya to USA", path: destinationRoutes.usa.path },
  { label: "Kenya to UAE", path: destinationRoutes.uae.path },
  { label: "Kenya to Europe", path: destinationRoutes.europe.path },
  { label: "Kenya to Africa", path: destinationRoutes.africa.path },
];

const serviceItems = [
  { label: "Air Freight", path: coreRoutes.airFreight.path },
  { label: "Sea Freight", path: coreRoutes.seaFreight.path },
  { label: "Customs Clearance", path: coreRoutes.customsClearance.path },
  { label: "Cargo Consolidation", path: coreRoutes.cargoConsolidation.path },
  { label: "Door-to-Door", path: coreRoutes.doorToDoor.path },
  { label: "Shop & Ship", path: coreRoutes.shopAndShip.path },
  { label: "Business Logistics", path: coreRoutes.businessLogistics.path },
];

const routeItems = [
  { label: "China to Kenya", path: originRoutes.china.path },
  { label: "UK to Kenya", path: originRoutes.uk.path },
  { label: "USA to Kenya", path: originRoutes.usa.path },
  { label: "UAE to Kenya", path: originRoutes.uae.path },
  { label: "South Africa to Kenya", path: originRoutes["south-africa"].path },
  { label: "Kenya to UK", path: destinationRoutes.uk.path },
  { label: "Kenya to USA", path: destinationRoutes.usa.path },
  { label: "Kenya to UAE", path: destinationRoutes.uae.path },
  { label: "Kenya to Europe", path: destinationRoutes.europe.path },
  { label: "Kenya to Africa", path: destinationRoutes.africa.path },
];

const toolItems = [
  { label: "Shipping Calculator", path: toolRoutes.shippingCalculator.path },
  { label: "Volumetric Weight", path: toolRoutes.volumetricWeightCalculator.path },
  { label: "CBM Calculator", path: toolRoutes.cbmCalculator.path },
  { label: "Track Shipment", path: toolRoutes.trackShipment.path },
];

const primaryNav = [
  { label: "Home", path: "/", items: null },
  { label: "Import", path: importLanding.path, items: importItems },
  { label: "Export", path: exportLanding.path, items: exportItems },
  { label: "Services", path: "#services", items: serviceItems },
  { label: "Routes", path: "#routes", items: routeItems },
  { label: "Tools", path: "#tools", items: toolItems },
  { label: "Shipping Centre", path: shippingCentreLanding.path, items: null },
  { label: "Locations", path: locationsLanding.path, items: null },
  { label: "About", path: coreRoutes.about.path, items: null },
];
---

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-primary focus:text-primary-foreground focus:px-4 focus:py-2 focus:rounded">Skip to content</a>

<header class="sticky top-0 z-40 w-full border-b border-border/40 bg-background/95 backdrop-blur">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href="/" class="flex items-center shrink-0" aria-label={site.name + " home"}>
        <img src="/images/logo-transparent.png" alt={site.name} class="h-10 w-auto" width="160" height="40" loading="eager" />
      </a>

      <nav class="hidden lg:flex items-center gap-1 flex-1 justify-center" aria-label="Primary navigation">
        {primaryNav.map((item) => (
          <div class="relative group">
            {item.items ? (
              <Fragment>
                <a href={item.path} class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-foreground hover:text-primary rounded-md transition-colors">
                  {item.label}
                  <svg class="h-3 w-3 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M3 5l3 3 3-3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 absolute left-0 top-full pt-1 transition-opacity duration-150 z-50" role="menu">
                  <ul class="min-w-[220px] bg-popover border border-border rounded-lg shadow-lg py-2">
                    {item.items.map((sub) => (
                      <li role="none">
                        <a href={sub.path} class="block px-4 py-2 text-sm text-popover-foreground hover:bg-muted hover:text-primary transition-colors" role="menuitem">
                          {sub.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </Fragment>
            ) : (
              <a href={item.path} class="inline-flex items-center px-3 py-2 text-sm font-medium text-foreground hover:text-primary rounded-md transition-colors">
                {item.label}
              </a>
            )}
          </div>
        ))}
      </nav>

      <div class="hidden lg:flex items-center gap-2 shrink-0">
        <a href={toolRoutes.trackShipment.path} class="inline-flex items-center rounded-md border border-border px-3 py-2 text-sm font-medium hover:bg-muted transition-colors">
          Track Shipment
        </a>
        <a href={coreRoutes.requestQuote.path} class="inline-flex items-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-4 py-2 text-sm font-semibold transition-colors">
          Get a Quote
        </a>
      </div>

      <div class="flex lg:hidden items-center gap-2 shrink-0">
        <a href={importLanding.path} class="inline-flex items-center rounded-md border border-border text-xs font-medium px-3 py-1.5 hover:bg-muted transition-colors">Import</a>
        <a href={exportLanding.path} class="inline-flex items-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover text-xs font-semibold px-3 py-1.5 transition-colors">Export</a>
      </div>
    </div>
  </div>

  <nav class="lg:hidden border-t border-border/40 overflow-x-auto whitespace-nowrap" aria-label="Primary navigation (mobile)">
    <ul class="flex items-center gap-1 px-4 py-2 min-w-max">
      {primaryNav.map((item) => (
        <li>
          {item.items ? (
            <details class="group">
              <summary class="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-foreground hover:text-primary rounded-md transition-colors cursor-pointer list-none">
                {item.label}
                <svg class="h-3 w-3 transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M3 5l3 3 3-3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <ul class="mt-1 ml-2 mb-2 space-y-0.5">
                {item.items.map((sub) => (
                  <li>
                    <a href={sub.path} class="block px-3 py-1.5 text-sm text-muted-foreground hover:text-primary transition-colors">
                      {sub.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={item.path} class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-foreground hover:text-primary rounded-md transition-colors">
              {item.label}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>
