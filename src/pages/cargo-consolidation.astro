---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site, whatsappLink } from "@/config/site";
import { coreRoutes, toolRoutes, originRoutes } from "@/config/routes";

const title = "Cargo Consolidation to Kenya | Kisima Cargo";
const description = "Combine multiple supplier shipments into one consolidated cargo to Kenya. Reduce cost and simplify customs with Kisima Cargo.";
const canonicalPath = "/cargo-consolidation";
const waHref = whatsappLink("Hello Kisima Cargo. I would like information about consolidating cargo to Kenya.");

const faqs = [
  { q: "What is cargo consolidation?", a: "Consolidation combines cargo from multiple suppliers or purchases into a single shipment and single clearance. This reduces per-unit freight cost and simplifies documentation." },
  { q: "Who is consolidation for?", a: "Anyone with orders from more than one supplier, or with multiple orders from the same supplier arriving at different times, or with small shipments that would be uneconomic alone." },
  { q: "Does consolidation delay my shipment?", a: "It can add a short waiting period at the origin warehouse while we accumulate cargo for the next departure. That's the trade-off for lower cost." },
  { q: "How is consolidated cargo charged?", a: "The consolidated shipment is charged as a single unit — by chargeable weight (air) or total CBM (sea) — plus one clearance." },
  { q: "Which origins support consolidation?", a: "Consolidation is available from every supported origin: China, UK, USA, UAE and South Africa." },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Cargo Consolidation to Kenya",
    serviceType: "Freight consolidation",
    provider: { "@type": "Organization", name: site.name, url: site.productionUrl },
    areaServed: { "@type": "Country", name: "Kenya" },
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} structuredData={structuredData}>
  <section class="bg-gradient-to-br from-primary via-primary to-secondary text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-accent uppercase tracking-wide mb-3">Service</p>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold leading-tight mb-5">Cargo consolidation</h1>
        <p class="text-lg text-white/90 leading-relaxed mb-8">
          Combine cargo from multiple suppliers into one shipment and one clearance. Lower per-unit freight cost, simpler documentation, fewer handoffs.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3 text-base font-semibold transition-colors">Get shipping estimate</a>
          <a href={waHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-md px-6 py-3 text-base font-semibold text-white underline underline-offset-4 decoration-white/50 hover:decoration-white transition-colors">Talk on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-background">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-muted-foreground leading-relaxed">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-foreground">Who consolidation suits</h2>
      <ul class="space-y-3">
        <li class="flex gap-3"><span class="text-accent shrink-0 mt-1">•</span><span>Buyers ordering from more than one supplier in the same origin country.</span></li>
        <li class="flex gap-3"><span class="text-accent shrink-0 mt-1">•</span><span>Retailers and e-commerce sellers accumulating multiple small orders.</span></li>
        <li class="flex gap-3"><span class="text-accent shrink-0 mt-1">•</span><span>Businesses building inventory over time without shipping each order separately.</span></li>
        <li class="flex gap-3"><span class="text-accent shrink-0 mt-1">•</span><span>Anyone whose shipments would be uneconomic if sent alone.</span></li>
      </ul>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-muted/30">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-muted-foreground leading-relaxed">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-foreground">How it works</h2>
      <ol class="space-y-4 list-none">
        <li class="flex gap-4"><span class="text-accent font-heading font-bold text-lg shrink-0">01</span><span>Cargo from each supplier arrives at our origin warehouse.</span></li>
        <li class="flex gap-4"><span class="text-accent font-heading font-bold text-lg shrink-0">02</span><span>We check, record and hold cargo for the next consolidation departure.</span></li>
        <li class="flex gap-4"><span class="text-accent font-heading font-bold text-lg shrink-0">03</span><span>When ready, we book a single shipment for the combined cargo.</span></li>
        <li class="flex gap-4"><span class="text-accent font-heading font-bold text-lg shrink-0">04</span><span>One clearance in Nairobi. One delivery or collection.</span></li>
      </ol>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-6">Consolidation origins</h2>
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {Object.values(originRoutes).map((r) => (
          <li>
            <a href={r.path} class="group block rounded-lg border border-border hover:border-accent hover:shadow-sm px-4 py-4 text-center transition-all">
              <span class="text-sm font-medium group-hover:text-primary transition-colors">{r.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-muted/30">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-6">Consolidation FAQ</h2>
      <div class="space-y-6">
        {faqs.map((item) => (
          <div class="border-b border-border pb-6">
            <h3 class="font-heading font-semibold text-lg mb-2">{item.q}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-gradient-to-r from-primary to-secondary text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-4">Consolidate your cargo</h2>
      <p class="text-lg text-white/85 mb-8">Talk to us about combining multiple suppliers into one shipment.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={waHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3 text-base font-semibold transition-colors">Ask on WhatsApp</a>
        <a href={coreRoutes.requestQuote.path} class="inline-flex items-center justify-center rounded-md border-2 border-white text-white hover:bg-white hover:text-primary px-6 py-3 text-base font-semibold transition-colors">Request a quote</a>
      </div>
    </div>
  </section>
</BaseLayout>
