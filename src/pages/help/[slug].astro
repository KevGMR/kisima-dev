---
/**
 * src/pages/help/[slug].astro
 * ===========================================================================
 * Dynamic help article page.
 *
 * Structure per Change Brief Section 7 (AEO/GEO content standards):
 *   Question -> Direct answer -> Explanation -> Example/bullets -> CTA
 *
 * Every Q&A block is rendered as an H2 (question) + direct answer paragraph,
 * not hidden in an accordion — so both crawlers and AI answer engines can
 * extract the content.
 * ===========================================================================
 */

import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site, whatsappLink } from "@/config/site";
import { coreRoutes, toolRoutes } from "@/config/routes";

export async function getStaticPaths() {
  const entries = await getCollection("help");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;

const canonicalPath = `/help/${entry.id}`;
const title = data.title;
const description = data.description;

const waHref = whatsappLink(
  `Hello Kisima Cargo. I have a question about: ${data.label}.`
);

// ---------------------------------------------------------------------------
// Structured data — Article + FAQPage (using the Q&A blocks) + BreadcrumbList
// ---------------------------------------------------------------------------
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.label,
  description: data.description,
  publisher: {
    "@type": "Organization",
    name: site.name,
    url: site.productionUrl,
  },
  mainEntityOfPage: `${site.productionUrl}${canonicalPath}`,
  ...(data.lastReviewed ? { datePublished: data.lastReviewed, dateModified: data.lastReviewed } : {}),
  ...(data.reviewer ? { author: { "@type": "Person", name: data.reviewer } } : {}),
};

const faqSchema = data.sections.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: data.sections.map((s) => ({
        "@type": "Question",
        name: s.question,
        acceptedAnswer: { "@type": "Answer", text: s.answer },
      })),
    }
  : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.productionUrl },
    { "@type": "ListItem", position: 2, name: "Help Centre", item: `${site.productionUrl}/help` },
    { "@type": "ListItem", position: 3, name: data.label, item: `${site.productionUrl}${canonicalPath}` },
  ],
};

const structuredData = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  structuredData={structuredData}
>

  <nav aria-label="Breadcrumb" class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 text-xs text-muted-foreground">
    <ol class="flex gap-2 items-center flex-wrap">
      <li><a href="/" class="hover:text-primary">Home</a></li>
      <li aria-hidden="true">›</li>
      <li><a href="/help" class="hover:text-primary">Help Centre</a></li>
      <li aria-hidden="true">›</li>
      <li class="text-foreground font-medium">{data.label}</li>
    </ol>
  </nav>

  <article class="py-10 md:py-14 bg-background">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Category chip -->
      <p class="text-xs font-medium text-accent uppercase tracking-wide mb-3">
        {data.category}
      </p>

      <!-- H1 -->
      <h1 class="text-3xl md:text-4xl font-heading font-bold mb-6">
        {data.label}
      </h1>

      <!-- Lede -->
      <p class="text-lg text-muted-foreground leading-relaxed mb-10">
        {data.description}
      </p>

      <!-- Q&A sections -->
      <div class="space-y-10">
        {data.sections.map((s) => (
          <section>
            <h2 class="text-xl md:text-2xl font-heading font-semibold mb-3">
              {s.question}
            </h2>
            <p class="text-foreground leading-relaxed mb-3">
              {s.answer}
            </p>
            {s.explanation && (
              <p class="text-muted-foreground leading-relaxed mb-3">
                {s.explanation}
              </p>
            )}
            {s.bullets && s.bullets.length > 0 && (
              <ul class="space-y-2 mt-3">
                {s.bullets.map((b) => (
                  <li class="flex gap-3 text-muted-foreground">
                    <span class="text-accent shrink-0 mt-1">•</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>

      <!-- Sources (if any) -->
      {data.sources && data.sources.length > 0 && (
        <section class="mt-12 rounded-lg border border-border bg-muted/30 p-5">
          <h2 class="text-sm font-heading font-semibold uppercase tracking-wide mb-3">
            Sources
          </h2>
          <ul class="space-y-2 text-sm">
            {data.sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Last reviewed -->
      {data.lastReviewed && (
        <p class="mt-10 text-xs text-muted-foreground">
          Last reviewed: {data.lastReviewed}
          {data.reviewer && <> · Reviewed by {data.reviewer}</>}
        </p>
      )}

      <!-- CTA -->
      <section class="mt-14 rounded-lg border border-border bg-muted/30 p-6">
        <h2 class="text-lg font-heading font-semibold mb-3">
          Still have a question?
        </h2>
        <p class="text-sm text-muted-foreground mb-4">
          We're happy to help with your specific shipment.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-5 py-2.5 text-sm font-semibold transition-colors"
          >
            Ask on WhatsApp
          </a>
          <a
            href={toolRoutes.shippingCalculator.path}
            class="inline-flex items-center justify-center rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-background transition-colors"
          >
            Get an estimate
          </a>
          <a
            href={coreRoutes.contact.path}
            class="inline-flex items-center justify-center rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-background transition-colors"
          >
            Contact us
          </a>
        </div>
      </section>

      <!-- Back to Help Centre -->
      <div class="mt-10">
        <a href="/help" class="inline-flex items-center text-primary hover:underline font-medium">
          ← Back to Help Centre
        </a>
      </div>

    </div>
  </article>
</BaseLayout>
