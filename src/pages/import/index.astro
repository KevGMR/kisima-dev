---
/**
 * src/pages/import/index.astro
 * Import to Kenya — landing page.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site, whatsappLink } from "@/config/site";
import {
  coreRoutes,
  originRoutes,
  businessRoutes,
  toolRoutes,
  shippingCentreRoutes,
  shippingCentreLanding,
} from "@/config/routes";

const title = "Import to Kenya | Air & Sea Freight | Kisima Cargo";
const description = "Bringing goods into Kenya? Ship personal cargo, commercial stock, machinery, electronics, clothing and more from supported international origins.";
const canonicalPath = "/import";

const waHref = whatsappLink("Hello Kisima Cargo. I would like information about importing to Kenya.");

const faqs = [
  {
    q: "Which countries can Kisima import from?",
    a: "We currently support imports into Kenya from China, the UK, USA, UAE and South Africa. Other origins may be possible — ask us on WhatsApp.",
  },
  {
    q: "Should I use air freight or sea freight for imports?",
    a: "Air freight is faster and suits urgent, high-value or smaller shipments. Sea freight is more economical for bulk and heavy cargo.",
  },
  {
    q: "Can you handle customs clearance?",
    a: "Yes. We prepare import documentation, file the Import Declaration Form (IDF), and coordinate customs clearance in Nairobi on your behalf.",
  },
  {
    q: "Can I consolidate goods from multiple suppliers?",
    a: "Yes. Consolidation combines multiple suppliers into one shipment and one clearance — usually reducing per-item freight cost.",
  },
  {
    q: "Do I need a phone number to get an estimate?",
    a: "No. You'll see the estimate first. We only ask for contact details when you request a confirmed quote.",
  },
  {
    q: "How do I get a confirmed quote?",
    a: "Use the shipping calculator for an estimate, then request a quote through the form or WhatsApp. We respond within one business day.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: `${site.productionUrl}/import`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];

const importSteps = [
  { step: "01", title: "Source or buy goods", body: "Buy from a supplier or online store in a supported origin country." },
  { step: "02", title: "Deliver to Kisima", body: "Send cargo to our origin warehouse, or arrange supplier pickup." },
  { step: "03", title: "Cargo processing", body: "We receive, check and consolidate cargo for the next departure." },
  { step: "04", title: "International freight", body: "Air or sea freight booked to Kenya, tracked through transit." },
  { step: "05", title: "Kenya customs", body: "Documentation and clearance handled in Nairobi." },
  { step: "06", title: "Collection or delivery", body: "Collect from our warehouse or choose door-to-door delivery." },
];

const airVsSea = [
  { label: "Best for", air: "Urgent shipments, high-value goods, smaller parcels", sea: "Large volumes, bulky cargo, cost-sensitive shipments" },
  { label: "Charging basis", air: "Chargeable weight (actual vs volumetric)", sea: "CBM (cubic metres)" },
  { label: "Typical transit", air: "Days, depending on route", sea: "Weeks, depending on route" },
  { label: "Relative cost", air: "Higher per kg", sea: "Lower per CBM" },
];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} structuredData={structuredData}>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary via-primary to-secondary text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-accent uppercase tracking-wide mb-3">Import</p>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold leading-tight mb-5">
          Import to Kenya
        </h1>
        <p class="text-lg text-white/90 leading-relaxed mb-8">
          Bring goods into Kenya from China, the UK, USA, UAE and South Africa. Air and sea freight, consolidation, customs clearance and delivery for individuals and businesses.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3 text-base font-semibold transition-colors">Get shipping estimate</a>
          <a href={waHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-md border-2 border-white/70 text-white hover:bg-white hover:text-primary px-6 py-3 text-base font-semibold transition-colors">Talk on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why import through Kisima -->
  <section class="py-14 md:py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl md:text-3xl font-heading font-bold mb-3">Why import through Kisima</h2>
        <p class="text-lg text-muted-foreground">Straightforward reasons, not slogans.</p>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <li class="rounded-xl border border-border p-6">
          <h3 class="font-heading font-semibold text-lg mb-2">Five origins</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">China, UK, USA, UAE and South Africa supported for imports into Kenya.</p>
        </li>
        <li class="rounded-xl border border-border p-6">
          <h3 class="font-heading font-semibold text-lg mb-2">Consolidation</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Combine multiple suppliers into one shipment and one clearance.</p>
        </li>
        <li class="rounded-xl border border-border p-6">
          <h3 class="font-heading font-semibold text-lg mb-2">Customs handled</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Documentation and clearance managed in Nairobi.</p>
        </li>
        <li class="rounded-xl border border-border p-6">
          <h3 class="font-heading font-semibold text-lg mb-2">Air and sea</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Choose the mode that fits your timeline and cargo.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- Import routes -->
  <section class="py-14 md:py-16 bg-muted/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl md:text-3xl font-heading font-bold mb-3">Import routes into Kenya</h2>
        <p class="text-lg text-muted-foreground">Pick an origin to see route-specific costs, cargo categories and FAQ.</p>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {Object.values(originRoutes).map((route) => (
          <li>
            <a href={route.path} class="group block rounded-xl border border-border bg-background hover:border-accent hover:shadow-md p-5 h-full transition-all">
              <span class="block font-heading font-semibold text-lg mb-1 group-hover:text-primary transition-colors">{route.label}</span>
              <span class="block text-sm text-muted-foreground">to Kenya</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Air vs Sea -->
  <section class="py-14 md:py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl md:text-3xl font-heading font-bold mb-3">Air vs sea for imports</h2>
        <p class="text-lg text-muted-foreground">How to choose the right method.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm md:text-base border-collapse">
          <thead>
            <tr class="border-b-2 border-border">
              <th class="text-left py-3 pr-4 font-heading font-semibold"></th>
              <th class="text-left py-3 pr-4 font-heading font-semibold">Air Freight</th>
              <th class="text-left py-3 font-heading font-semibold">Sea Freight</th>
            </tr>
          </thead>
          <tbody>
            {airVsSea.map((row) => (
              <tr class="border-b border-border">
                <td class="py-4 pr-4 font-medium align-top">{row.label}</td>
                <td class="py-4 pr-4 text-muted-foreground align-top">{row.air}</td>
                <td class="py-4 text-muted-foreground align-top">{row.sea}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={coreRoutes.airFreight.path} class="inline-flex items-center rounded-md border border-border px-4 py-2 text-sm font-medium hover:bg-muted transition-colors">Learn about air freight →</a>
        <a href={coreRoutes.seaFreight.path} class="inline-flex items-center rounded-md border border-border px-4 py-2 text-sm font-medium hover:bg-muted transition-colors">Learn about sea freight →</a>
      </div>
    </div>
  </section>

  <!-- Common cargo -->
  <section class="py-14 md:py-16 bg-muted/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl md:text-3xl font-heading font-bold mb-3">Common cargo we import</h2>
        <p class="text-lg text-muted-foreground">We handle these categories regularly.</p>
      </div>
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {Object.values(businessRoutes).map((cat) => (
          <li>
            <a href={cat.path} class="group block rounded-lg border border-border bg-background hover:border-accent hover:shadow-sm px-4 py-5 text-center transition-all">
              <span class="block text-sm font-medium group-hover:text-primary transition-colors">{cat.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-14 md:py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl md:text-3xl font-heading font-bold mb-3">How importing to Kenya works</h2>
        <p class="text-lg text-muted-foreground">A clear six-step process from supplier to your door.</p>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {importSteps.map((s) => (
          <li>
            <span class="block font-heading font-bold text-3xl text-accent mb-3">{s.step}</span>
            <h3 class="text-lg font-heading font-semibold mb-2">{s.title}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-14 md:py-16 bg-muted/30">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-8">Import FAQ</h2>
      <div class="space-y-6">
        {faqs.map((item) => (
          <div class="border-b border-border pb-6">
            <h3 class="font-heading font-semibold text-lg mb-2">{item.q}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
      <div class="mt-8">
        <a href={shippingCentreLanding.path} class="inline-flex items-center text-primary hover:underline font-medium">Visit the Shipping Centre →</a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-14 md:py-16 bg-gradient-to-r from-primary to-secondary text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-4">Ready to import to Kenya?</h2>
      <p class="text-lg text-white/85 mb-8">Calculate an estimate or request a confirmed quote.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3 text-base font-semibold transition-colors">Get shipping estimate</a>
        <a href={coreRoutes.requestQuote.path} class="inline-flex items-center justify-center rounded-md border-2 border-white text-white hover:bg-white hover:text-primary px-6 py-3 text-base font-semibold transition-colors">Request a quote</a>
      </div>
    </div>
  </section>

</BaseLayout>
