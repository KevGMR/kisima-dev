---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site, whatsappLink } from "@/config/site";
import { originRoutes, toolRoutes, helpRoutes, coreRoutes } from "@/config/routes";

const title = "Air Freight to Kenya | International Cargo | Kisima Cargo";
const description = "Air freight to Kenya from China, the UK, USA, UAE and other supported markets. Fast transit, chargeable-weight pricing and customs support from Kisima Cargo.";
const canonicalPath = "/air-freight";
const waHref = whatsappLink("Hello Kisima Cargo. I would like a quote for air freight to Kenya.");

const faqs = [
  { q: "What is air freight?", a: "Air freight is cargo transported by aircraft. It is the faster shipping method, typically measured in days from departure rather than weeks." },
  { q: "When should I use air freight?", a: "Air freight suits urgent shipments, high-value goods, smaller parcels, and cases where speed is more important than cost per kg." },
  { q: "How is air freight charged?", a: "Air freight is charged on chargeable weight — the higher of actual weight and volumetric weight (length × width × height ÷ the route-specific divisor)." },
  { q: "Can I ship fragile items by air?", a: "Yes. Air freight actually reduces handling time compared to sea, which can be an advantage for fragile or high-value cargo. Packaging still matters." },
  { q: "Are there restrictions?", a: "Yes. Lithium batteries, liquids, aerosols, and certain hazardous materials have specific rules. We confirm your specific items before booking." },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Air Freight to Kenya",
    serviceType: "Air freight forwarding",
    provider: { "@type": "Organization", name: site.name, url: site.productionUrl },
    areaServed: { "@type": "Country", name: "Kenya" },
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} structuredData={structuredData}>
  <section class="bg-gradient-to-br from-primary via-primary to-secondary text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-accent uppercase tracking-wide mb-3">Service</p>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold leading-tight mb-5">
          Air freight to Kenya
        </h1>
        <p class="text-lg text-white/90 leading-relaxed mb-8">
          Fast, tracked air freight from supported origins into Kenya. Suited to urgent shipments, high-value goods and smaller parcels where speed matters more than cost per kg.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3 text-base font-semibold transition-colors">
            Get shipping estimate
          </a>
          <a href={waHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-md px-6 py-3 text-base font-semibold text-white underline underline-offset-4 decoration-white/50 hover:decoration-white transition-colors">
            Talk on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-background">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-muted-foreground leading-relaxed">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-foreground">Who air freight suits</h2>
      <ul class="space-y-3">
        <li class="flex gap-3"><span class="text-accent shrink-0 mt-1">•</span><span>Time-sensitive shipments where delays cost more than higher freight rates.</span></li>
        <li class="flex gap-3"><span class="text-accent shrink-0 mt-1">•</span><span>High-value goods where reduced transit time reduces exposure.</span></li>
        <li class="flex gap-3"><span class="text-accent shrink-0 mt-1">•</span><span>Smaller parcels where sea freight minimums or consolidation timings don't suit.</span></li>
        <li class="flex gap-3"><span class="text-accent shrink-0 mt-1">•</span><span>Fragile or delicate items where less handling is preferable.</span></li>
      </ul>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-muted/30">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 text-muted-foreground leading-relaxed">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-foreground">How air freight is charged</h2>
      <p>
        Air freight is charged on <strong class="text-foreground">chargeable weight</strong>: the higher of actual scale weight and volumetric weight (length × width × height ÷ the route-specific divisor). That chargeable weight is multiplied by the current air rate for your route.
      </p>
      <p>
        Handling fees, minimum charges and additional services are shown separately — never buried in the rate.
      </p>
      <p>
        <a href={helpRoutes["volumetric-weight"].path} class="text-primary hover:underline font-medium">Read: What is volumetric weight? →</a>
      </p>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-6">Air freight routes into Kenya</h2>
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {Object.values(originRoutes).map((r) => (
          <li>
            <a href={r.path} class="group block rounded-lg border border-border hover:border-accent hover:shadow-sm px-4 py-4 text-center transition-all">
              <span class="text-sm font-medium group-hover:text-primary transition-colors">{r.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-muted/30">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-6">Air freight FAQ</h2>
      <div class="space-y-6">
        {faqs.map((item) => (
          <div class="border-b border-border pb-6">
            <h3 class="font-heading font-semibold text-lg mb-2">{item.q}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 md:py-16 bg-gradient-to-r from-primary to-secondary text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-4">Ship by air to Kenya</h2>
      <p class="text-lg text-white/85 mb-8">Get an estimate or request a confirmed air freight quote.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3 text-base font-semibold transition-colors">Get shipping estimate</a>
        <a href={coreRoutes.requestQuote.path} class="inline-flex items-center justify-center rounded-md border-2 border-white text-white hover:bg-white hover:text-primary px-6 py-3 text-base font-semibold transition-colors">Request a quote</a>
      </div>
    </div>
  </section>
</BaseLayout>
