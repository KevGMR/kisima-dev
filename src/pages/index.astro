---
/**
 * src/pages/index.astro
 * ===========================================================================
 * Homepage — global import/export positioning.
 *
 * Structure per Brief Rev 2, Section 5 (15-section scroll order):
 *   1.  Global import/export hero
 *   2.  Import or export selector
 *   3.  Quick shipping estimator
 *   4.  Core services
 *   5.  Global network
 *   6.  Popular import routes
 *   7.  Export from Kenya
 *   8.  How it works (import / export journeys)
 *   9.  Business logistics
 *   10. Why Kisima
 *   11. Kisima Shipping Centre
 *   12. Testimonials / case studies (placeholder)
 *   13. FAQ
 *   14. Final quote CTA
 *   15. Footer (handled by BaseLayout)
 * ===========================================================================
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import heroImg from "@/assets/hero-logistics.jpeg";
import globalNetworkImg from "@/assets/global-network.jpeg";
import { site, whatsappLink } from "@/config/site";
import {
  coreRoutes,
  originRoutes,
  destinationRoutes,
  businessRoutes,
  toolRoutes,
  shippingCentreRoutes,
  shippingCentreLanding,
  locationsLanding,
  importLanding,
  exportLanding,
} from "@/config/routes";

const title = "Global Import & Export Logistics | Air & Sea Freight | Kisima Cargo";
const description = "Move goods into Kenya or export from Kenya to global markets. Air freight, sea freight, customs clearance, consolidation and door-to-door logistics from Kisima Cargo.";
const canonicalPath = "/";

const waHref = whatsappLink("Hello Kisima Cargo. I would like a shipping quote.");

/* ---------------------------------------------------------------------------
 * Section data
 * ------------------------------------------------------------------------- */

const coreServices = [
  {
    title: "Air Freight",
    body: "Fast international import and export for time-sensitive cargo.",
    path: coreRoutes.airFreight.path,
  },
  {
    title: "Sea Freight",
    body: "Cost-effective logistics for heavy, bulky and high-volume shipments.",
    path: coreRoutes.seaFreight.path,
  },
  {
    title: "Customs Clearance",
    body: "Import and export customs support and documentation guidance.",
    path: coreRoutes.customsClearance.path,
  },
  {
    title: "Cargo Consolidation",
    body: "Combine eligible shipments before international freight.",
    path: coreRoutes.cargoConsolidation.path,
  },
  {
    title: "Door-to-Door Logistics",
    body: "Origin-to-destination delivery where available.",
    path: coreRoutes.doorToDoor.path,
  },
  {
    title: "Business Logistics",
    body: "Freight solutions for commercial importers, exporters and wholesalers.",
    path: coreRoutes.businessLogistics.path,
  },
];

const globalNetwork = [
  { city: "Nairobi, Kenya", role: "Head Office" },
  { city: "Hayes, United Kingdom", role: "Receiving Warehouse" },
  { city: "Dubai, UAE", role: "Receiving Warehouse" },
  { city: "Guangzhou, China", role: "Receiving Warehouse" },
  { city: "Virginia, USA", role: "Receiving Warehouse" },
  { city: "Johannesburg, South Africa", role: "Receiving Warehouse" },
];

const importJourney = [
  { step: "01", title: "Source or buy goods", body: "Buy from a supplier or online store in a supported origin country." },
  { step: "02", title: "Deliver to Kisima / supplier pickup", body: "Send cargo to our origin warehouse, or arrange supplier pickup." },
  { step: "03", title: "Cargo processing & consolidation", body: "We receive, check and consolidate cargo for the next departure." },
  { step: "04", title: "International freight", body: "Air or sea freight booked to Kenya, tracked through transit." },
  { step: "05", title: "Kenya customs clearance", body: "Documentation and clearance handled in Nairobi." },
  { step: "06", title: "Collection or final delivery", body: "Collect from our warehouse or choose door-to-door delivery." },
];

const exportJourney = [
  { step: "01", title: "Tell us what you're exporting", body: "Cargo type, volume, destination and timeframe." },
  { step: "02", title: "Prepare documentation", body: "Commercial invoice, packing list, certificate of origin and export declaration." },
  { step: "03", title: "Cargo collection / delivery to Kisima", body: "Deliver to our Nairobi warehouse, or arrange supplier pickup." },
  { step: "04", title: "Export clearance", body: "Export declaration filed and cleared at the Kenyan port or airport." },
  { step: "05", title: "Air or sea freight", body: "Booked to the destination country, tracked through transit." },
  { step: "06", title: "Destination delivery / handoff", body: "Delivery or handoff at destination, coordinated with your destination broker." },
];

const shippingCentreCards = [
  shippingCentreRoutes["getting-started"],
  shippingCentreRoutes["how-to-export-from-kenya"],
  shippingCentreRoutes["shipping-costs"],
  shippingCentreRoutes["customs-clearance-kenya"],
  shippingCentreRoutes["export-documents-kenya"],
  shippingCentreRoutes["what-is-cbm"],
].filter(Boolean);

const faqs = [
  {
    q: "Does Kisima handle both imports and exports?",
    a: "Yes. Kisima Cargo handles imports into Kenya and exports from Kenya. Supported import origins include China, the UK, USA, UAE and South Africa. Supported export destinations include the UK, USA, UAE, Europe and other African markets.",
  },
  {
    q: "Which countries does Kisima Cargo ship to and from?",
    a: "Imports into Kenya from China, the UK, USA, UAE and South Africa. Exports from Kenya to the UK, USA, UAE, Europe and other African destinations. Other origins or destinations may be possible — ask us on WhatsApp.",
  },
  {
    q: "Can Kisima handle business cargo?",
    a: "Yes. We handle commercial imports and exports across categories including clothing, electronics, machinery, auto parts, wholesale stock and e-commerce. See the Business Logistics page for detail.",
  },
  {
    q: "Does Kisima arrange customs clearance?",
    a: "Yes. We prepare documentation, file declarations, and coordinate customs clearance for both imports into Kenya and exports from Kenya.",
  },
  {
    q: "How do I get a shipping estimate?",
    a: "Use the shipping calculator for an instant estimate based on route, method, weight and dimensions. No sign-up required. Request a confirmed quote when you want an exact price.",
  },
  {
    q: "Can I track my shipment?",
    a: "Yes. Use the track shipment tool with your reference, or contact us on WhatsApp for an update.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  structuredData={structuredData}
>

  <!-- =====================================================================
       1. HERO
       ===================================================================== -->
  <section class="relative overflow-hidden text-white min-h-[70vh] md:min-h-[75vh] flex items-center">
    <Image
      src={heroImg}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      widths={[800, 1200, 1600, 2000]}
      sizes="100vw"
      format="webp"
      loading="eager"
      quality={80}
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-secondary/95 via-primary/85 to-primary/60" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 lg:py-28 w-full">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold leading-tight mb-6">
          Global Import &amp; Export Logistics, Simplified.
        </h1>

        <p class="text-lg md:text-xl text-white/90 leading-relaxed mb-8 max-w-2xl">
          Move goods into Kenya or export from Kenya to global markets with Kisima Cargo. We provide air freight, sea freight, customs clearance, cargo consolidation and door-to-door logistics for individuals and businesses.
        </p>

        <div class="flex flex-col sm:flex-row flex-wrap gap-3 pt-2">
          <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3 text-base font-semibold transition-colors">
            Get shipping estimate
          </a>
          <a href={toolRoutes.trackShipment.path} class="inline-flex items-center justify-center rounded-md border-2 border-white/70 text-white hover:bg-white hover:text-primary px-6 py-3 text-base font-semibold transition-colors">
            Track shipment
          </a>
          <a href={waHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-md px-6 py-3 text-base font-semibold text-white underline underline-offset-4 decoration-white/50 hover:decoration-white transition-colors">
            Talk to us on WhatsApp
          </a>
        </div>

        <div class="pt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm text-white/80">
          <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>Air Freight</span>
          <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>Sea Freight</span>
          <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>Consolidation</span>
          <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>Customs Support</span>
          <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>Door-to-Door</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       2. IMPORT OR EXPORT SELECTOR
       ===================================================================== -->
  <section class="py-12 md:py-16 bg-background border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-3 text-center">
        What are you shipping?
      </h2>
      <p class="text-lg text-muted-foreground text-center mb-10 max-w-2xl mx-auto">
        Choose the direction that fits your shipment.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <a href={importLanding.path} class="group block rounded-2xl border-2 border-border hover:border-accent hover:shadow-lg p-8 transition-all">
          <p class="text-xs font-medium text-accent uppercase tracking-wide mb-3">Import</p>
          <h3 class="text-2xl font-heading font-bold mb-3 group-hover:text-primary transition-colors">Import to Kenya</h3>
          <p class="text-muted-foreground leading-relaxed mb-5">
            Bringing goods into Kenya? Ship personal cargo, commercial stock, machinery, electronics, clothing and more from supported international origins.
          </p>
          <span class="inline-flex items-center text-accent font-semibold group-hover:underline">
            Explore imports →
          </span>
        </a>

        <a href={exportLanding.path} class="group block rounded-2xl border-2 border-border hover:border-accent hover:shadow-lg p-8 transition-all">
          <p class="text-xs font-medium text-accent uppercase tracking-wide mb-3">Export</p>
          <h3 class="text-2xl font-heading font-bold mb-3 group-hover:text-primary transition-colors">Export from Kenya</h3>
          <p class="text-muted-foreground leading-relaxed mb-5">
            Shipping goods from Kenya to the world? Send commercial cargo, products and personal shipments from Kenya to supported international destinations.
          </p>
          <span class="inline-flex items-center text-accent font-semibold group-hover:underline">
            Explore exports →
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       3. QUICK ESTIMATOR
       ===================================================================== -->
  <section class="py-12 md:py-16 bg-muted/40 border-b border-border">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-background rounded-2xl shadow-lg border border-border p-6 md:p-8">
        <h2 class="text-2xl md:text-3xl font-heading font-semibold mb-2">
          How much might my shipment cost?
        </h2>
        <p class="text-muted-foreground mb-6">
          Get a quick estimate in under a minute. No sign-up required.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <label class="block">
            <span class="text-sm font-medium mb-1.5 block">Shipping from</span>
            <select class="w-full rounded-md border border-input bg-background px-3 py-2.5 text-sm" disabled>
              <option>Select origin</option>
              {Object.values(originRoutes).map((r) => (<option>{r.label}</option>))}
            </select>
          </label>
          <label class="block">
            <span class="text-sm font-medium mb-1.5 block">Method</span>
            <select class="w-full rounded-md border border-input bg-background px-3 py-2.5 text-sm" disabled>
              <option>Air Freight</option>
              <option>Sea Freight</option>
            </select>
          </label>
          <label class="block">
            <span class="text-sm font-medium mb-1.5 block">Approx. weight (kg)</span>
            <input type="number" min="0" step="0.1" placeholder="e.g. 25" class="w-full rounded-md border border-input bg-background px-3 py-2.5 text-sm" disabled />
          </label>
        </div>

        <div class="mt-5 flex flex-wrap gap-3">
          <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-5 py-2.5 text-sm font-semibold transition-colors">
            Calculate estimate
          </a>
          <a href={coreRoutes.requestQuote.path} class="inline-flex items-center justify-center rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-muted transition-colors">
            Request a confirmed quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       4. CORE SERVICES
       ===================================================================== -->
  <section class="py-16 md:py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3">
          Core services
        </h2>
        <p class="text-lg text-muted-foreground">
          Import and export logistics across air, sea, customs and delivery.
        </p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {coreServices.map((s) => (
          <li>
            <a href={s.path} class="group block rounded-xl border border-border hover:border-accent hover:shadow-md p-6 h-full transition-all">
              <h3 class="font-heading font-semibold text-xl mb-2 group-hover:text-primary transition-colors">
                {s.title}
              </h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{s.body}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- =====================================================================
       5. GLOBAL NETWORK
       ===================================================================== -->
  <section class="relative overflow-hidden text-white">
    <Image
      src={globalNetworkImg}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      widths={[800, 1200, 1600]}
      sizes="100vw"
      format="webp"
      loading="lazy"
      quality={80}
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-secondary/95 via-secondary/85 to-primary/75" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
      <div class="max-w-3xl mb-10">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3">
          One network. Multiple markets.
        </h2>
        <p class="text-lg text-white/80">
          Kisima Cargo connects Kenya with global sourcing and destination markets through our international network.
        </p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {globalNetwork.map((loc) => (
          <li class="rounded-xl border border-white/15 bg-white/5 backdrop-blur-sm p-5">
            <p class="text-xs font-medium text-accent uppercase tracking-wide mb-1">{loc.role}</p>
            <p class="font-heading font-semibold text-lg">{loc.city}</p>
          </li>
        ))}
      </ul>

      <div class="mt-8">
        <a href={locationsLanding.path} class="inline-flex items-center text-accent hover:underline font-medium">
          See all locations →
        </a>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       6. POPULAR IMPORT ROUTES
       ===================================================================== -->
  <section class="py-16 md:py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3">
          Popular import routes
        </h2>
        <p class="text-lg text-muted-foreground">
          Origins we support into Kenya.
        </p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {Object.values(originRoutes).map((route) => (
          <li>
            <a href={route.path} class="group block rounded-xl border border-border bg-background hover:border-accent hover:shadow-md p-5 h-full transition-all">
              <span class="block font-heading font-semibold text-lg mb-1 group-hover:text-primary transition-colors">{route.label}</span>
              <span class="block text-sm text-muted-foreground">to Kenya</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- =====================================================================
       7. EXPORT FROM KENYA
       ===================================================================== -->
  <section class="py-16 md:py-20 bg-muted/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-5">
          <p class="text-sm font-medium text-accent uppercase tracking-wide mb-3">Export</p>
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4">
            Export from Kenya
          </h2>
          <p class="text-lg text-muted-foreground leading-relaxed mb-6">
            Send commercial cargo, agricultural products (where permitted), handicrafts, textiles and personal shipments from Kenya to supported international destinations.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={exportLanding.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-5 py-2.5 text-sm font-semibold transition-colors">
              Explore exports
            </a>
            <a href={coreRoutes.requestQuote.path} class="inline-flex items-center justify-center rounded-md border border-border px-5 py-2.5 text-sm font-medium hover:bg-background transition-colors">
              Request a quote
            </a>
          </div>
        </div>

        <div class="lg:col-span-7">
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {Object.values(destinationRoutes).map((dest) => (
              <li>
                <a href={dest.path} class="group block rounded-lg border border-border bg-background hover:border-accent hover:shadow-sm px-5 py-4 transition-all">
                  <span class="block text-sm font-medium group-hover:text-primary transition-colors">Kenya to {dest.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       8. HOW IT WORKS (Import / Export journeys)
       ===================================================================== -->
  <section class="py-16 md:py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3">
          How it works
        </h2>
        <p class="text-lg text-muted-foreground">
          Two journeys, one process. Import or export.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <div>
          <h3 class="text-xl font-heading font-semibold mb-6 pb-3 border-b-2 border-accent">
            Import journey
          </h3>
          <ol class="space-y-5">
            {importJourney.map((step) => (
              <li class="flex gap-4">
                <span class="font-heading font-bold text-2xl text-accent shrink-0">{step.step}</span>
                <div>
                  <h4 class="font-heading font-semibold mb-1">{step.title}</h4>
                  <p class="text-sm text-muted-foreground leading-relaxed">{step.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div>
          <h3 class="text-xl font-heading font-semibold mb-6 pb-3 border-b-2 border-accent">
            Export journey
          </h3>
          <ol class="space-y-5">
            {exportJourney.map((step) => (
              <li class="flex gap-4">
                <span class="font-heading font-bold text-2xl text-accent shrink-0">{step.step}</span>
                <div>
                  <h4 class="font-heading font-semibold mb-1">{step.title}</h4>
                  <p class="text-sm text-muted-foreground leading-relaxed">{step.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       9. BUSINESS LOGISTICS
       ===================================================================== -->
  <section class="py-16 md:py-20 bg-muted/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3">
          Business logistics
        </h2>
        <p class="text-lg text-muted-foreground">
          Commercial imports and exports across common categories.
        </p>
      </div>

      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-8">
        {Object.values(businessRoutes).map((cat) => (
          <li>
            <a href={cat.path} class="group block rounded-lg border border-border bg-background hover:border-accent hover:shadow-sm px-4 py-5 text-center transition-all">
              <span class="block text-sm font-medium group-hover:text-primary transition-colors">{cat.label}</span>
            </a>
          </li>
        ))}
      </ul>

      <a href={coreRoutes.businessLogistics.path} class="inline-flex items-center text-primary hover:underline font-medium">
        Business logistics overview →
      </a>
    </div>
  </section>

  <!-- =====================================================================
       10. WHY KISIMA
       ===================================================================== -->
  <section class="py-16 md:py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3">
          Why Kisima
        </h2>
        <p class="text-lg text-muted-foreground">
          Straightforward reasons, not slogans.
        </p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <li class="rounded-xl border border-border p-6">
          <h3 class="font-heading font-semibold text-lg mb-2">Global network</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Warehouses and offices across Kenya, the UK, UAE, China, USA and South Africa.</p>
        </li>
        <li class="rounded-xl border border-border p-6">
          <h3 class="font-heading font-semibold text-lg mb-2">Two-way logistics</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Both imports into Kenya and exports from Kenya handled with the same process.</p>
        </li>
        <li class="rounded-xl border border-border p-6">
          <h3 class="font-heading font-semibold text-lg mb-2">Real consolidation</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Combine multiple suppliers or orders into one shipment and one clearance.</p>
        </li>
        <li class="rounded-xl border border-border p-6">
          <h3 class="font-heading font-semibold text-lg mb-2">Customs handled</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Documentation and clearance prepared and filed on your behalf.</p>
        </li>
        <li class="rounded-xl border border-border p-6">
          <h3 class="font-heading font-semibold text-lg mb-2">Air and sea</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Choose the mode that fits your timeline and cargo.</p>
        </li>
        <li class="rounded-xl border border-border p-6">
          <h3 class="font-heading font-semibold text-lg mb-2">Direct contact</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">Talk to a person on WhatsApp, phone or email.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- =====================================================================
       11. KISIMA SHIPPING CENTRE
       ===================================================================== -->
  <section class="py-16 md:py-20 bg-muted/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3">
          Kisima Shipping Centre
        </h2>
        <p class="text-lg text-muted-foreground">
          Practical guides for importing, exporting and moving cargo internationally.
        </p>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {shippingCentreCards.map((g) => (
          <li>
            <a href={g.path} class="group block rounded-xl border border-border bg-background hover:border-accent hover:shadow-md p-6 h-full transition-all">
              <p class="text-xs font-medium text-accent uppercase tracking-wide mb-2">{g.category}</p>
              <h3 class="font-heading font-semibold text-lg mb-2 group-hover:text-primary transition-colors">
                {g.label}
              </h3>
              <p class="text-sm text-muted-foreground leading-relaxed">
                {g.description}
              </p>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-8">
        <a href={shippingCentreLanding.path} class="inline-flex items-center text-primary hover:underline font-medium">
          Visit the full Shipping Centre →
        </a>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       12. TESTIMONIALS / CASE STUDIES — placeholder
       ===================================================================== -->
  <section class="py-16 md:py-20 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3">
          Customer stories
        </h2>
        <p class="text-lg text-muted-foreground">
          Real customer proof — coming soon.
        </p>
      </div>

      <div class="rounded-xl border border-dashed border-border bg-muted/30 p-8 text-center">
        <p class="text-muted-foreground italic">
          Verified customer stories and case studies will appear here once approved by Marketing.
        </p>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       13. FAQ
       ===================================================================== -->
  <section class="py-16 md:py-20 bg-muted/30">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-3">
          Frequently asked questions
        </h2>
        <p class="text-lg text-muted-foreground">
          The questions we hear most often.
        </p>
      </div>

      <div class="space-y-6">
        {faqs.map((item) => (
          <div class="border-b border-border pb-6">
            <h3 class="font-heading font-semibold text-lg mb-2">{item.q}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>

      <div class="mt-8">
        <a href={waHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-primary hover:underline font-medium">
          Ask a different question on WhatsApp →
        </a>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       14. FINAL CTA
       ===================================================================== -->
  <section class="py-16 md:py-20 bg-gradient-to-r from-primary to-secondary text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4">
        Ready to move goods into or out of Kenya?
      </h2>
      <p class="text-lg text-white/85 mb-8">
        Get an estimate, request a quote, or talk to us on WhatsApp.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3 text-base font-semibold transition-colors">
          Get shipping estimate
        </a>
        <a href={coreRoutes.requestQuote.path} class="inline-flex items-center justify-center rounded-md border-2 border-white text-white hover:bg-white hover:text-primary px-6 py-3 text-base font-semibold transition-colors">
          Request a quote
        </a>
      </div>
    </div>
  </section>

  <!-- 15. Footer — rendered by BaseLayout -->

</BaseLayout>
