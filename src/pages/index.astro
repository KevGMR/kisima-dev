---
/**
 * src/pages/index.astro
 * ===========================================================================
 * Homepage — minimalist conversion-focused rebuild.
 *
 * Design brief: fewer paragraphs, more visuals, clear actions.
 * Structural model: Kentex Cargo / Rolling Cargo.
 *
 * Structure:
 *   1.  Hero (bold H1, single CTA, track input)
 *   2.  Import / Export selector (compact)
 *   3.  How it works (6-step visual grid)
 *   4.  Core services (photo + icon cards)
 *   5.  Pricing CTA
 *   6.  Global network (one line)
 *   7.  Popular routes (compact)
 *   8.  Business logistics (icon grid)
 *   9.  Shipping Centre (3 cards)
 *   10. Testimonials placeholder
 *   11. FAQ (3 items)
 *   12. Final CTA
 * ===========================================================================
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { site, whatsappLink } from "@/config/site";
import {
  coreRoutes,
  originRoutes,
  destinationRoutes,
  businessRoutes,
  toolRoutes,
  shippingCentreRoutes,
  shippingCentreLanding,
  locationsLanding,
  importLanding,
  exportLanding,
} from "@/config/routes";

import heroImg from "@/assets/hero-minimal.jpg";
import processImg from "@/assets/process-step.jpg";
import serviceAirImg from "@/assets/service-air.jpg";
import serviceSeaImg from "@/assets/service-sea.jpg";
import serviceCustomsImg from "@/assets/service-customs.jpg";
import serviceConsolidationImg from "@/assets/service-consolidation.jpg";
import serviceDoorToDoorImg from "@/assets/service-door-to-door.jpg";
import serviceBusinessImg from "@/assets/service-business.jpg";

const title = "Global Import & Export Logistics | Air & Sea Freight | Kisima Cargo";
const description = "Move goods into Kenya or export from Kenya to global markets. Air freight, sea freight, customs clearance, consolidation and door-to-door logistics from Kisima Cargo.";
const canonicalPath = "/";

const waHref = whatsappLink("Hello Kisima Cargo. I would like a shipping quote.");
const TRACKING_URL = "https://app.kisimacargo.com";

const importSteps = [
  { icon: "cart", title: "Buy or source goods", body: "From any supported origin country." },
  { icon: "box", title: "Deliver to our warehouse", body: "Supplier pickup available on request." },
  { icon: "plane", title: "We ship and clear customs", body: "Air or sea, tracked end to end." },
  { icon: "home", title: "Collect or we deliver", body: "Door-to-door across Kenya." },
];

const exportSteps = [
  { icon: "box", title: "Tell us what you're exporting", body: "Cargo type, volume, destination." },
  { icon: "file", title: "We prepare documents", body: "Invoice, packing list, export declaration." },
  { icon: "plane", title: "We clear and ship", body: "Export clearance in Nairobi, air or sea." },
  { icon: "globe", title: "Destination handoff", body: "Delivery or pickup with your broker." },
];

const services = [
  {
    title: "Air Freight",
    body: "Fast, tracked air cargo.",
    path: coreRoutes.airFreight.path,
    image: serviceAirImg,
    alt: "Air cargo loading",
  },
  {
    title: "Sea Freight",
    body: "Cost-effective ocean freight.",
    path: coreRoutes.seaFreight.path,
    image: serviceSeaImg,
    alt: "Container ship",
  },
  {
    title: "Customs Clearance",
    body: "Import and export clearance.",
    path: coreRoutes.customsClearance.path,
    image: serviceCustomsImg,
    alt: "Customs documentation",
  },
  {
    title: "Cargo Consolidation",
    body: "Combine multiple suppliers.",
    path: coreRoutes.cargoConsolidation.path,
    image: serviceConsolidationImg,
    alt: "Consolidated warehouse cargo",
  },
  {
    title: "Door-to-Door",
    body: "Origin to final delivery.",
    path: coreRoutes.doorToDoor.path,
    image: serviceDoorToDoorImg,
    alt: "Last-mile cargo delivery",
  },
  {
    title: "Business Logistics",
    body: "For importers and exporters.",
    path: coreRoutes.businessLogistics.path,
    image: serviceBusinessImg,
    alt: "Commercial freight operations",
  },
];

const faqs = [
  {
    q: "Do you handle both imports and exports?",
    a: "Yes. We ship into Kenya from China, the UK, USA, UAE and South Africa, and out of Kenya to the UK, USA, UAE, Europe and other African markets.",
  },
  {
    q: "How do I get a price?",
    a: "Use the shipping calculator for an instant estimate, or request a quote for a confirmed price based on your exact cargo.",
  },
  {
    q: "Can I track my shipment?",
    a: "Yes. Use the tracking tool on this site with the reference we sent you, or message us on WhatsApp.",
  },
];

const shippingCentreCards = [
  shippingCentreRoutes["getting-started"],
  shippingCentreRoutes["how-to-export-from-kenya"],
  shippingCentreRoutes["shipping-costs"],
].filter(Boolean);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  structuredData={structuredData}
>

  <!-- ============ 1. HERO ============ -->
  <section class="relative overflow-hidden text-white min-h-[80vh] md:min-h-[85vh] flex items-center">
    <Image
      src={heroImg}
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
      widths={[800, 1200, 1600]}
      sizes="100vw"
      format="webp"
      loading="eager"
      quality={70}
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-secondary/95 via-primary/90 to-primary/65" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 w-full">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-accent uppercase tracking-widest mb-4">
          Global Import &amp; Export Logistics
        </p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold leading-[1.05] mb-6">
          Import to and from Kenya, and beyond.
        </h1>
        <p class="text-lg md:text-xl text-white/85 leading-relaxed mb-8 max-w-xl">
          Air freight, sea freight, consolidation and customs — from supported international origins to Kenya, and from Kenya to global markets.
        </p>

        <!-- Primary CTA + track input side by side -->
        <div class="flex flex-col sm:flex-row gap-3 max-w-xl">
          <a
            href={toolRoutes.shippingCalculator.path}
            class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3.5 text-base font-semibold transition-colors shrink-0"
          >
            Get Shipping Estimate
          </a>

          <form
            action={TRACKING_URL}
            method="get"
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-1 rounded-md border border-white/30 overflow-hidden bg-white/10 backdrop-blur-sm"
          >
            <label for="hero-track-input" class="sr-only">Tracking number</label>
            <input
              id="hero-track-input"
              name="ref"
              type="text"
              placeholder="Tracking number"
              class="flex-1 bg-transparent text-white placeholder-white/60 px-4 py-3.5 text-sm outline-none"
            />
            <button
              type="submit"
              class="bg-white/10 hover:bg-white/20 text-white px-5 py-3.5 text-sm font-semibold border-l border-white/30 transition-colors"
            >
              Track
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 2. IMPORT / EXPORT SELECTOR ============ -->
  <section class="py-10 md:py-12 bg-background border-b border-border">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a
          href={importLanding.path}
          class="group flex items-center justify-between gap-4 rounded-xl border-2 border-border hover:border-accent hover:bg-muted/40 px-6 py-5 transition-all"
        >
          <div>
            <p class="text-xs font-semibold text-accent uppercase tracking-wide mb-1">Import</p>
            <p class="text-lg font-heading font-semibold group-hover:text-primary transition-colors">Import to Kenya</p>
          </div>
          <svg class="h-6 w-6 text-muted-foreground group-hover:text-accent group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" stroke-linecap="round" />
            <polyline points="12 5 19 12 12 19" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href={exportLanding.path}
          class="group flex items-center justify-between gap-4 rounded-xl border-2 border-border hover:border-accent hover:bg-muted/40 px-6 py-5 transition-all"
        >
          <div>
            <p class="text-xs font-semibold text-accent uppercase tracking-wide mb-1">Export</p>
            <p class="text-lg font-heading font-semibold group-hover:text-primary transition-colors">Export from Kenya</p>
          </div>
          <svg class="h-6 w-6 text-muted-foreground group-hover:text-accent group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" stroke-linecap="round" />
            <polyline points="12 5 19 12 12 19" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 3. HOW IT WORKS ============ -->
  <section class="py-16 md:py-24 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">

        <!-- Image anchor -->
        <div class="lg:col-span-5 order-2 lg:order-1">
          <Image
            src={processImg}
            alt="Cargo handling at Kisima Cargo"
            class="w-full h-auto rounded-2xl shadow-xl"
            widths={[600, 900, 1200]}
            sizes="(max-width: 1024px) 100vw, 40vw"
            format="webp"
            loading="lazy"
            quality={75}
          />
        </div>

        <!-- Steps -->
        <div class="lg:col-span-7 order-1 lg:order-2">
          <p class="text-sm font-semibold text-accent uppercase tracking-widest mb-3">How it works</p>
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10">
            From supplier to your door
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {importSteps.map((step, i) => (
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 rounded-full bg-accent/10 text-accent flex items-center justify-center font-heading font-bold text-base">
                  {String(i + 1).padStart(2, "0")}
                </div>
                <div>
                  <h3 class="font-heading font-semibold text-base mb-1">{step.title}</h3>
                  <p class="text-sm text-muted-foreground leading-relaxed">{step.body}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-8">
            <a href={importLanding.path} class="inline-flex items-center text-primary hover:underline font-medium text-sm">
              Full import process →
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ 4. CORE SERVICES ============ -->
  <section class="py-16 md:py-24 bg-muted/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <p class="text-sm font-semibold text-accent uppercase tracking-widest mb-3">Services</p>
        <h2 class="text-3xl md:text-4xl font-heading font-bold">
          What we do
        </h2>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((s) => (
          <li>
            <a href={s.path} class="group block rounded-2xl bg-background border border-border hover:border-accent hover:shadow-lg overflow-hidden transition-all h-full">

              {s.image ? (
                <div class="aspect-[16/10] overflow-hidden bg-muted">
                  <Image
                    src={s.image}
                    alt={s.alt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    widths={[400, 600, 800]}
                    sizes="(max-width: 1024px) 100vw, 33vw"
                    format="webp"
                    loading="lazy"
                    quality={75}
                  />
                </div>
              ) : (
                <div class="aspect-[16/10] flex items-center justify-center bg-gradient-to-br from-primary to-secondary text-white">
                  <svg class="h-14 w-14 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <rect x="3" y="6" width="18" height="13" rx="1" />
                    <path d="M3 10h18 M8 6v13 M16 6v13" />
                  </svg>
                </div>
              )}

              <div class="p-6">
                <h3 class="font-heading font-semibold text-lg mb-1 group-hover:text-primary transition-colors">
                  {s.title}
                </h3>
                <p class="text-sm text-muted-foreground">{s.body}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 5. PRICING CTA ============ -->
  <section class="py-16 md:py-24 bg-background">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm font-semibold text-accent uppercase tracking-widest mb-3">Pricing</p>
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4">
        Get a quote for exact pricing
      </h2>
      <p class="text-lg text-muted-foreground mb-8 max-w-2xl mx-auto">
        Rates vary by route, method and cargo. Get an instant estimate, or request a confirmed price for your shipment.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3.5 text-base font-semibold transition-colors">
          Get Shipping Estimate
        </a>
        <a href={coreRoutes.requestQuote.path} class="inline-flex items-center justify-center rounded-md border-2 border-border hover:bg-muted px-6 py-3.5 text-base font-semibold transition-colors">
          Request a Quote
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 6. GLOBAL NETWORK (one line) ============ -->
  <section class="py-12 bg-secondary text-secondary-foreground">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-sm md:text-base text-secondary-foreground/70">
          <span class="font-heading font-semibold text-accent mr-2">Our network:</span>
          Nairobi · Hayes · Dubai · Guangzhou · Virginia · Johannesburg
        </p>
        <a href={locationsLanding.path} class="text-sm font-medium text-accent hover:underline shrink-0">
          See all locations →
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 7. POPULAR ROUTES (compact) ============ -->
  <section class="py-16 md:py-24 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
        <div>
          <p class="text-sm font-semibold text-accent uppercase tracking-widest mb-3">Routes</p>
          <h2 class="text-3xl md:text-4xl font-heading font-bold">Popular routes</h2>
        </div>
        <a href="/routes" class="text-sm font-medium text-primary hover:underline">All routes →</a>
      </div>

      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {Object.values(originRoutes).map((route) => (
          <li>
            <a href={route.path} class="group block rounded-xl border border-border hover:border-accent hover:shadow-md bg-background p-5 text-center transition-all">
              <span class="block font-heading font-semibold text-base group-hover:text-primary transition-colors">{route.label}</span>
              <span class="block text-xs text-muted-foreground mt-1">to Kenya</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 8. BUSINESS LOGISTICS (icon grid) ============ -->
  <section class="py-16 md:py-24 bg-muted/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-10">
        <p class="text-sm font-semibold text-accent uppercase tracking-widest mb-3">Business</p>
        <h2 class="text-3xl md:text-4xl font-heading font-bold">For commercial importers and exporters</h2>
      </div>

      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {Object.values(businessRoutes).map((cat) => (
          <li>
            <a href={cat.path} class="group block rounded-lg border border-border bg-background hover:border-accent hover:shadow-sm px-4 py-5 text-center transition-all">
              <span class="block text-sm font-medium group-hover:text-primary transition-colors">{cat.label}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-8">
        <a href={coreRoutes.businessLogistics.path} class="inline-flex items-center text-primary hover:underline font-medium text-sm">
          Business logistics overview →
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 9. SHIPPING CENTRE ============ -->
  <section class="py-16 md:py-24 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
        <div>
          <p class="text-sm font-semibold text-accent uppercase tracking-widest mb-3">Shipping Centre</p>
          <h2 class="text-3xl md:text-4xl font-heading font-bold">Practical guides</h2>
        </div>
        <a href={shippingCentreLanding.path} class="text-sm font-medium text-primary hover:underline">All guides →</a>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {shippingCentreCards.map((g) => (
          <li>
            <a href={g.path} class="group block rounded-xl border border-border bg-background hover:border-accent hover:shadow-md p-6 h-full transition-all">
              <p class="text-xs font-medium text-accent uppercase tracking-wide mb-2">{g.category}</p>
              <h3 class="font-heading font-semibold text-lg mb-2 group-hover:text-primary transition-colors">
                {g.label}
              </h3>
              <p class="text-sm text-muted-foreground leading-relaxed">{g.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 10. TESTIMONIALS PLACEHOLDER ============ -->
  <section class="py-12 bg-muted/40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm text-muted-foreground italic">
        Verified customer stories coming soon.
      </p>
    </div>
  </section>

  <!-- ============ 11. FAQ ============ -->
  <section class="py-16 md:py-24 bg-background">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-accent uppercase tracking-widest mb-3">FAQ</p>
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10">Common questions</h2>
      <div class="space-y-6">
        {faqs.map((item) => (
          <div class="border-b border-border pb-6">
            <h3 class="font-heading font-semibold text-lg mb-2">{item.q}</h3>
            <p class="text-muted-foreground leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
      <div class="mt-8">
        <a href={waHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-primary hover:underline font-medium text-sm">
          Ask a question on WhatsApp →
        </a>
      </div>
    </div>
  </section>

  <!-- ============ 12. FINAL CTA ============ -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-primary via-primary to-secondary text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4">
        Ready to ship?
      </h2>
      <p class="text-lg text-white/85 mb-8">
        Get an estimate, request a quote, or talk to us on WhatsApp.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3.5 text-base font-semibold transition-colors">
          Get Shipping Estimate
        </a>
        <a href={coreRoutes.requestQuote.path} class="inline-flex items-center justify-center rounded-md border-2 border-white text-white hover:bg-white hover:text-primary px-6 py-3.5 text-base font-semibold transition-colors">
          Request a Quote
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
