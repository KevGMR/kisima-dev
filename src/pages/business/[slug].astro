---
/**
 * src/pages/business/[slug].astro
 * ===========================================================================
 * Dynamic business category page — one per category.
 *
 * Content is pulled from src/content/business/*.md.
 * Adding a new category = adding one markdown file.
 * ===========================================================================
 */

import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site, whatsappLink } from "@/config/site";
import { coreRoutes, originRoutes, toolRoutes, helpRoutes } from "@/config/routes";

export async function getStaticPaths() {
  const entries = await getCollection("business");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;

const canonicalPath = `/business/${entry.id}`;
const title = `Shipping ${data.label} to Kenya | Kisima Cargo`;
const description = data.lede.slice(0, 155);

const waHref = whatsappLink(
  `Hello Kisima Cargo. I need a quote for shipping ${data.label.toLowerCase()} to Kenya.`
);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: `Shipping ${data.label} to Kenya`,
  serviceType: "International freight forwarding",
  provider: { "@type": "Organization", name: site.name, url: site.productionUrl },
  areaServed: { "@type": "Country", name: "Kenya" },
  description: data.lede,
};

const faqSchema = data.faqs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: data.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.productionUrl },
    { "@type": "ListItem", position: 2, name: "Business", item: `${site.productionUrl}/business/${entry.id}` },
    { "@type": "ListItem", position: 3, name: data.label, item: `${site.productionUrl}${canonicalPath}` },
  ],
};

const structuredData = [serviceSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];

const origins = Object.values(originRoutes);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  structuredData={structuredData}
>

  <nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 text-xs text-muted-foreground">
    <ol class="flex gap-2 items-center">
      <li><a href="/" class="hover:text-primary">Home</a></li>
      <li aria-hidden="true">›</li>
      <li><a href="/business" class="hover:text-primary">Business</a></li>
      <li aria-hidden="true">›</li>
      <li class="text-foreground font-medium">{data.label}</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary via-primary to-secondary text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
      <div class="max-w-3xl">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold leading-tight mb-5">
          Shipping {data.label} to Kenya
        </h1>
        <p class="text-lg text-white/90 leading-relaxed mb-8">
          {data.lede}
        </p>
        <div class="flex flex-col sm:flex-row flex-wrap gap-3">
          <a
            href={toolRoutes.shippingCalculator.path}
            class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3 text-base font-semibold transition-colors"
          >
            Get shipping estimate
          </a>
          <a
            href={coreRoutes.requestQuote.path}
            class="inline-flex items-center justify-center rounded-md border-2 border-white/70 text-white hover:bg-white hover:text-primary px-6 py-3 text-base font-semibold transition-colors"
          >
            Request a quote
          </a>
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-md px-6 py-3 text-base font-semibold text-white underline underline-offset-4 decoration-white/50 hover:decoration-white transition-colors"
          >
            Ask on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Common examples -->
  <section class="py-14 md:py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-6">
        What we ship in this category
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {data.examples.map((item) => (
          <li class="rounded-lg border border-border bg-background px-4 py-3 text-sm">
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Considerations -->
  <section class="py-14 md:py-16 bg-muted/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-6">
        Practical considerations
      </h2>
      <ul class="space-y-3">
        {data.considerations.map((c) => (
          <li class="flex gap-3">
            <span class="text-accent shrink-0 mt-1">•</span>
            <span class="text-muted-foreground leading-relaxed">{c}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Origins -->
  <section class="py-14 md:py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-4">
        Ship {data.label.toLowerCase()} from
      </h2>
      <p class="text-muted-foreground mb-8 max-w-2xl">
        Select an origin to see route-specific details, common cargo and FAQ.
      </p>
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {origins.map((o) => (
          <li>
            <a
              href={o.path}
              class="group block rounded-lg border border-border hover:border-accent hover:shadow-sm px-4 py-4 text-center transition-all"
            >
              <span class="text-sm font-medium group-hover:text-primary transition-colors">
                {o.label}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Related help -->
  <section class="py-14 md:py-16 bg-muted/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-6">
        Related guides
      </h2>
      <div class="flex flex-wrap gap-3">
        <a href={helpRoutes["shipping-costs"].path} class="inline-flex items-center justify-center rounded-md border border-border bg-background px-5 py-2.5 text-sm font-medium hover:border-accent transition-colors">
          How shipping costs work
        </a>
        <a href={helpRoutes["customs-clearance-kenya"].path} class="inline-flex items-center justify-center rounded-md border border-border bg-background px-5 py-2.5 text-sm font-medium hover:border-accent transition-colors">
          Customs clearance in Kenya
        </a>
        <a href={helpRoutes["import-documents-kenya"].path} class="inline-flex items-center justify-center rounded-md border border-border bg-background px-5 py-2.5 text-sm font-medium hover:border-accent transition-colors">
          Import documents
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {data.faqs.length > 0 && (
    <section class="py-14 md:py-16 bg-background">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-heading font-bold mb-8">
          {data.label} shipping FAQ
        </h2>
        <div class="space-y-6">
          {data.faqs.map((item) => (
            <div class="border-b border-border pb-6">
              <h3 class="font-heading font-semibold text-lg mb-2">{item.q}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Final CTA -->
  <section class="py-14 md:py-16 bg-gradient-to-r from-primary to-secondary text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-4">
        Ready to ship {data.label.toLowerCase()} to Kenya?
      </h2>
      <p class="text-lg text-white/85 mb-8">
        Calculate an estimate or request a confirmed quote.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={toolRoutes.shippingCalculator.path}
          class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3 text-base font-semibold transition-colors"
        >
          Get shipping estimate
        </a>
        <a
          href={coreRoutes.requestQuote.path}
          class="inline-flex items-center justify-center rounded-md border-2 border-white text-white hover:bg-white hover:text-primary px-6 py-3 text-base font-semibold transition-colors"
        >
          Request a quote
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
