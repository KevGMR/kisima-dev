---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site, whatsappLink } from "@/config/site";
import { coreRoutes, toolRoutes, locationsLanding } from "@/config/routes";

interface Props {
  entry: import("astro:content").CollectionEntry<"countries">;
}

export async function getStaticPaths() {
  const entries = await getCollection("countries");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;

const canonicalPath = `/routes/countries/${entry.id}`;
const title = `Shipping to and from ${data.name} | Kisima Cargo`;
const description = data.lede.slice(0, 155);
const waHref = whatsappLink(`Hello Kisima Cargo. I would like information about shipping to or from ${data.name}.`);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: `Freight to and from ${data.name}`,
  serviceType: "International freight forwarding",
  provider: { "@type": "Organization", name: site.name, url: site.productionUrl },
  areaServed: { "@type": "Country", name: data.name },
  description: data.lede,
};

const faqSchema = data.faqs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: data.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.productionUrl },
    { "@type": "ListItem", position: 2, name: "Routes", item: `${site.productionUrl}/routes` },
    { "@type": "ListItem", position: 3, name: data.name, item: `${site.productionUrl}${canonicalPath}` },
  ],
};

const structuredData = [serviceSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} structuredData={structuredData}>

  <nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 text-xs text-muted-foreground">
    <ol class="flex gap-2 items-center flex-wrap">
      <li><a href="/" class="hover:text-primary">Home</a></li>
      <li aria-hidden="true">›</li>
      <li><a href="/routes" class="hover:text-primary">Routes</a></li>
      <li aria-hidden="true">›</li>
      <li class="text-foreground font-medium">{data.name}</li>
    </ol>
  </nav>

  <section class="bg-gradient-to-br from-primary via-primary to-secondary text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-accent uppercase tracking-wide mb-3">{data.role}</p>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold leading-tight mb-5">
          Shipping to and from {data.name}
        </h1>
        <p class="text-lg text-white/90 leading-relaxed mb-8">{data.lede}</p>
        <div class="flex flex-wrap gap-3">
          <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3 text-base font-semibold transition-colors">Get shipping estimate</a>
          <a href={waHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-md border-2 border-white/70 text-white hover:bg-white hover:text-primary px-6 py-3 text-base font-semibold transition-colors">Talk on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Connections -->
  <section class="py-14 md:py-16 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10">
      <div>
        <h2 class="text-xl font-heading font-semibold mb-4">Importing into {data.name} from</h2>
        <ul class="space-y-2">
          {data.importsFrom.map((c) => (
            <li class="flex gap-3 text-muted-foreground">
              <span class="text-accent shrink-0 mt-1">•</span>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-heading font-semibold mb-4">Exporting from {data.name} to</h2>
        <ul class="space-y-2">
          {data.exportsTo.map((c) => (
            <li class="flex gap-3 text-muted-foreground">
              <span class="text-accent shrink-0 mt-1">•</span>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Freight options -->
  <section class="py-14 md:py-16 bg-muted/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-8">Freight options</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {data.freightOptions.map((opt) => (
          <div class="rounded-xl border border-border bg-background p-6">
            <h3 class="font-heading font-semibold text-lg mb-2">{opt.mode} freight</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{opt.description}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={coreRoutes.airFreight.path} class="inline-flex items-center rounded-md border border-border px-4 py-2 text-sm font-medium hover:bg-muted transition-colors">Air freight services →</a>
        <a href={coreRoutes.seaFreight.path} class="inline-flex items-center rounded-md border border-border px-4 py-2 text-sm font-medium hover:bg-muted transition-colors">Sea freight services →</a>
      </div>
    </div>
  </section>

  <!-- Common cargo -->
  {(data.commonCargoIn || data.commonCargoOut) && (
    <section class="py-14 md:py-16 bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10">
        {data.commonCargoIn && data.commonCargoIn.length > 0 && (
          <div>
            <h2 class="text-xl font-heading font-semibold mb-4">Common cargo imported from {data.name}</h2>
            <ul class="grid grid-cols-1 gap-2">
              {data.commonCargoIn.map((c) => (
                <li class="rounded-lg border border-border px-4 py-3 text-sm">{c}</li>
              ))}
            </ul>
          </div>
        )}
        {data.commonCargoOut && data.commonCargoOut.length > 0 && (
          <div>
            <h2 class="text-xl font-heading font-semibold mb-4">Common cargo exported to {data.name}</h2>
            <ul class="grid grid-cols-1 gap-2">
              {data.commonCargoOut.map((c) => (
                <li class="rounded-lg border border-border px-4 py-3 text-sm">{c}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Documents -->
  <section class="py-14 md:py-16 bg-muted/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-6">Documents</h2>
      <ul class="space-y-2 mb-8">
        {data.documents.map((d) => (
          <li class="flex gap-3">
            <span class="text-accent shrink-0 mt-1">•</span>
            <span class="text-muted-foreground">{d}</span>
          </li>
        ))}
      </ul>
      <a href="/shipping-centre" class="inline-flex items-center text-primary hover:underline font-medium">Shipping Centre guides →</a>
    </div>
  </section>

  <!-- FAQ -->
  {data.faqs.length > 0 && (
    <section class="py-14 md:py-16 bg-background">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-heading font-bold mb-8">{data.name} — FAQ</h2>
        <div class="space-y-6">
          {data.faqs.map((item) => (
            <div class="border-b border-border pb-6">
              <h3 class="font-heading font-semibold text-lg mb-2">{item.q}</h3>
              <p class="text-muted-foreground leading-relaxed">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-14 md:py-16 bg-gradient-to-r from-primary to-secondary text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-4">Ship to or from {data.name}</h2>
      <p class="text-lg text-white/85 mb-8">Get an estimate or request a confirmed quote.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={toolRoutes.shippingCalculator.path} class="inline-flex items-center justify-center rounded-md bg-accent text-accent-foreground hover:bg-accent-hover px-6 py-3 text-base font-semibold transition-colors">Get shipping estimate</a>
        <a href={coreRoutes.requestQuote.path} class="inline-flex items-center justify-center rounded-md border-2 border-white text-white hover:bg-white hover:text-primary px-6 py-3 text-base font-semibold transition-colors">Request a quote</a>
      </div>
    </div>
  </section>

</BaseLayout>
