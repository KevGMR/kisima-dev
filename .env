# .env
# ===========================================================================
# Local development environment variables.
#
# Vite/Astro exposes variables prefixed with VITE_ to client code.
# This file should NOT be committed with production values.
#
# Production deploy contexts are configured in Netlify UI, not here.
# See docs/stack-decision.md Section 4.2 and docs/implementation-checklist.md
# ===========================================================================

# Site environment: "development" | "staging" | "production"
# Determines whether noindex is applied. See src/config/site.ts.
VITE_SITE_ENV=development

# The URL this build is served from. Used for OG previews and non-production
# canonical testing. Production canonical is hardcoded in src/config/site.ts.
VITE_SITE_URL=https://kisimadevs.netlify.app

# WhatsApp number in international format, digits only (no +, no spaces).
VITE_WHATSAPP=254795554137
